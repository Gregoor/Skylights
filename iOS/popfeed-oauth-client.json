{
  "client_id": "https://cdn.jsdelivr.net/gh/Gregoor/Skylights@main/iOS/popfeed-oauth-client-v2.json",
  "client_name": "Skylights",
  "application_type": "native",
  "redirect_uris": ["net.jsdelivr.cdn:/oauth/callback"],
  "grant_types": ["authorization_code", "refresh_token"],
